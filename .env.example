# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: supabase.com → project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://fbkktuvquupuirwvzscx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key  # get from Supabase Dashboard → Settings → API

# Service role key — NEVER expose to browser. Only used in server-side routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cron Security ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Set this same value in pg_cron SQL: 'Authorization: Bearer <value>'
CRON_SECRET=your-random-secret-here

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
# Only used for hot/active_deal accounts. Strictly gated.
ANTHROPIC_API_KEY=sk-ant-...

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: Default Project ────────────────────────────────────────────────
# Set to your Hireflow project UUID to skip project selection
NEXT_PUBLIC_DEFAULT_PROJECT_ID=cde9f58c-37b8-43c0-b5ac-9cbed23f7d1f
